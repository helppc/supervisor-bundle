{
  "name": "helppc/supervisor-bundle",
  "type": "symfony-bundle",
  "homepage": "https://github.com/helppc/supervisor-bundle",
  "license": "MIT",
  "description": "Manage your Supervisor instances from a Symfony application.",
  "keywords": [
    "supervisor",
    "supervisord",
    "supervisorctl",
    "rpc",
    "api",
    "symfony"
  ],
  "authors": [
    {
      "name": "Tomáš Kulhánek",
      "email": "jsem@tomaskulhanek.cz"
    }
  ],
  "require": {
    "php": ">=8.2",
    "lstrojny/fxmlrpc": "^0.22",
    "nyholm/psr7": "^1.8",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0 || ^1.1",
    "supervisorphp/supervisor": "^5.1",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
    "symfony/translation": "^6.4 || ^7.0 || ^8.0",
    "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "HelpPC\\Bundle\\SupervisorBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HelpPC\\Bundle\\SupervisorBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
    "symfony/css-selector": "^6.4 || ^7.0 || ^8.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
