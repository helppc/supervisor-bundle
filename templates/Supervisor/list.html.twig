{% extends '@Supervisor/layout.html.twig' %}
{% trans_default_domain 'SupervisorBundle' %}

{% block supervisor_content %}
    <h1>Supervisor</h1>

    {% for serverKey, server in servers %}
        <section class="supervisor-server">
            <h2>
                {{ serverKey }}
                <span class="supervisor-status supervisor-status-{{ server.connected ? 'up' : 'down' }}">
                    {{ (server.connected ? 'server.up' : 'server.down')|trans }}
                </span>
            </h2>

            {% if server.connected %}
                {% if server.processes is empty %}
                    <p>{{ 'no.processes'|trans }}</p>
                {% else %}
                    <table>
                        <thead>
                            <tr>
                                <th>{{ 'header.status'|trans }}</th>
                                <th>{{ 'header.process'|trans }}</th>
                                <th>{{ 'header.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for process in server.processes %}
                            {% set info = process.payload %}
                            {% set routeParams = { key: serverKey, group: info.group, name: info.name } %}
                            {% set running = info.state in [10, 20] %}
                            <tr>
                                <td>
                                    <span class="supervisor-status supervisor-status-{{ running ? 'up' : 'down' }}">{{ info.statename }}</span>
                                </td>
                                <td>
                                    <strong>{{ info.name }}</strong>
                                    {% if info.group != info.name %}<small>({{ info.group }})</small>{% endif %}
                                    <br>
                                    <small>{{ info.description }}</small>
                                </td>
                                <td>
                                    {% if running %}
                                        <form method="post" action="{{ path('supervisor.process.stop', routeParams) }}">
                                            <button type="submit">{{ 'stop'|trans }}</button>
                                        </form>
                                        <form method="post" action="{{ path('supervisor.process.restart', routeParams) }}">
                                            <button type="submit">{{ 'restart'|trans }}</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('supervisor.process.start', routeParams) }}">
                                            <button type="submit">{{ 'start'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    <a href="{{ path('supervisor.process.info', routeParams) }}">{{ 'information'|trans }}</a>
                                    <a href="{{ path('supervisor.process.log', routeParams) }}">{{ 'open.stdout'|trans }}</a>
                                    <a href="{{ path('supervisor.process.error', routeParams) }}">{{ 'open.stderr'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <p>
                        <small>
                            {{ 'version.supervisor'|trans }} <code>{{ server.supervisorVersion }}</code>,
                            {{ 'version.api'|trans }} <code>{{ server.apiVersion }}</code>
                            — <a href="{{ path('supervisor.log', { key: serverKey }) }}">{{ 'logs.view'|trans }}</a>
                        </small>
                    </p>
                {% endif %}
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
