{% extends '@Supervisor/layout.html.twig' %}

{% block supervisor_title %}{{ title }}{% endblock %}

{% block supervisor_content %}
    <h1>{{ title }}</h1>
    <p><a href="{{ path('supervisor') }}">{{ 'back'|trans({}, 'SupervisorBundle') }}</a></p>
    {% if informations is empty %}
        <p>{{ 'information.empty'|trans({}, 'SupervisorBundle') }}</p>
    {% else %}
        <table>
            <tbody>
            {% for property, value in informations %}
                <tr>
                    <th>{{ property }}</th>
                    <td>{{ value }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
